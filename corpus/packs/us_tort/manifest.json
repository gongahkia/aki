  "overlays": {
    "prompt": {
      "jurisdiction_guidance": [
        "Use US institutions, state/federal court labels, and US civil litigation terms when this pack is selected.",
        "Treat tort doctrine as state-law driven unless the source context supports a federal framing."
      ],
      "topic_hints": {
        "duty_of_care": "Include plaintiff-defendant relationship, foreseeability, and policy reasons for recognizing or limiting duty.",
        "causation": "Include but-for causation, proximate cause, and any multiple-defendant uncertainty.",
        "product_liability": "Include product, seller/manufacturer role, defect theory, user injury, and privity or warning facts.",
        "strict_liability": "Include activity/product risk and whether liability turns on fault or inherent danger.",
        "comparative_negligence": "Include plaintiff conduct and how fault could be apportioned."
      }
